# LLM provider (Anthropic-compatible API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=qwen3.7-plus
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# Application
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Redis
REDIS_PASSWORD=change_me_for_nonlocal_use
REDIS_URL=redis://:change_me_for_nonlocal_use@redis:6379/0

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
# 中文 BGE 使用独立 collection；切回旧模型时删除下面三行或改回
# all-MiniLM-L6-v2 / knowledge_base。
CHROMA_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHROMA_COLLECTION_NAME=knowledge_base_bge_v1
FASTEMBED_CACHE_PATH=/app/data/model-cache/fastembed

# Semantic evidence gate (fail closed on timeout/error)
EVIDENCE_SELECTOR_ENABLED=true
EVIDENCE_SELECTOR_TOP_K=3
EVIDENCE_SELECTOR_MAX_TOKENS=512
EVIDENCE_SELECTOR_TIMEOUT_SECONDS=45

# Monitoring
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
AGENT_LATENCY_WARNING_MS=30000
ALERT_WEBHOOK_URL=

# Evaluation safety limits
EVAL_INTENT_CASE_TIMEOUT_SECONDS=90
EVAL_INTENT_MAX_CONCURRENCY=2


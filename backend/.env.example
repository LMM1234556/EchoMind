# LLM provider (Anthropic-compatible API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=qwen3.7-plus
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# Application
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Redis
REDIS_PASSWORD=change_me_for_nonlocal_use
REDIS_URL=redis://:change_me_for_nonlocal_use@redis:6379/0

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# Monitoring
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
AGENT_LATENCY_WARNING_MS=30000
ALERT_WEBHOOK_URL=

